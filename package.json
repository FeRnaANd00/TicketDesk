{
  "name": "ticketdesk",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "deploy:rules": "firebase deploy --only firestore",
    "deploy": "ng build && firebase deploy --only hosting,firestore",
    "test:rules": "firebase emulators:exec --only firestore --project demo-ticketdesk \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --project demo-ticketdesk"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@fontsource-variable/material-symbols-outlined": "^5.3.9",
    "firebase": "13.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "autoprefixer": "^10.6.2",
    "firebase-tools": "^15.36.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "zod": "^4.6.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
