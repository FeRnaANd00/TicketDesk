rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDocument(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function userDocumentAfterWrite(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return signedIn() && userDocument(request.auth.uid).data.role == 'admin';
    }

    function isTechnician() {
      return signedIn() && userDocument(request.auth.uid).data.role == 'technician';
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'username', 'department', 'phone', 'role',
          'profileCompleted', 'createdAt'
        ]);
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['username', 'department', 'phone', 'profileCompleted']))
        || (isAdmin()
          && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['admin', 'technician']
          && (resource.data.role != 'admin' || request.resource.data.role == 'admin'))
      );
      allow delete: if false;
    }

    match /technicianDirectory/{uid} {
      allow get, list: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'department'])
        && request.resource.data.uid == uid
        && userDocumentAfterWrite(uid).data.role == 'technician'
        && request.resource.data.username == userDocumentAfterWrite(uid).data.username
        && request.resource.data.department == userDocumentAfterWrite(uid).data.department;
      allow delete: if isAdmin()
        && userDocumentAfterWrite(uid).data.role != 'technician';
    }

    match /ticketCounters/{counterId} {
      function pairedTicketMatches() {
        let ticket = getAfter(
          /databases/$(database)/documents/tickets/$(request.resource.data.lastTicketId)
        );
        return ticket.data.numero == request.resource.data.lastNumber
          && ticket.data.clienteId == request.auth.uid;
      }

      allow get: if signedIn() && counterId == 'global';
      allow list: if false;
      allow create: if signedIn()
        && counterId == 'global'
        && request.resource.data.keys().hasOnly(['lastNumber', 'lastTicketId'])
        && request.resource.data.lastNumber is int
        && request.resource.data.lastNumber == 1
        && request.resource.data.lastTicketId is string
        && pairedTicketMatches();
      allow update: if signedIn()
        && counterId == 'global'
        && request.resource.data.keys().hasOnly(['lastNumber', 'lastTicketId'])
        && request.resource.data.lastNumber is int
        && request.resource.data.lastNumber == resource.data.lastNumber + 1
        && request.resource.data.lastTicketId is string
        && pairedTicketMatches();
      allow delete: if false;
    }

    match /tickets/{ticketId} {
      function isRequester() {
        return signedIn() && resource.data.clienteId == request.auth.uid;
      }

      function isAssignedTechnician() {
        return signedIn() && resource.data.tecnicoAsignadoId == request.auth.uid;
      }

      function hasValidSupportAssignment() {
        return (
          !('tecnicoAsignadoId' in request.resource.data.keys())
          && !('tecnicoAsignadoNombre' in request.resource.data.keys())
        ) || (
          request.resource.data.tecnicoAsignadoId is string
          && request.resource.data.tecnicoAsignadoNombre is string
          && get(
            /databases/$(database)/documents/technicianDirectory/$(request.resource.data.tecnicoAsignadoId)
          ).data.uid == request.resource.data.tecnicoAsignadoId
          && get(
            /databases/$(database)/documents/technicianDirectory/$(request.resource.data.tecnicoAsignadoId)
          ).data.username == request.resource.data.tecnicoAsignadoNombre
        );
      }

      function hasValidTicketCategoryAndState() {
        return request.resource.data.categoria in [
            'Soporte Técnico', 'Redes y comunicaciones', 'Desarrollador de sistema'
          ]
          && request.resource.data.estado in ['abierto', 'en proceso', 'cerrado'];
      }

      function isValidAdminEdit() {
        return isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'categoria', 'estado', 'tecnicoAsignadoId', 'tecnicoAsignadoNombre'
          ])
          && hasValidTicketCategoryAndState()
          && hasValidSupportAssignment();
      }

      function isValidRequesterOrAssigneeEdit() {
        return signedIn()
          && resource.data.estado != 'cerrado'
          && (isRequester() || (isTechnician() && isAssignedTechnician()))
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['categoria', 'estado'])
          && hasValidTicketCategoryAndState();
      }

      function isValidSelfAssignment() {
        return isTechnician()
          && resource.data.estado == 'abierto'
          && (!('tecnicoAsignadoId' in resource.data.keys())
            || resource.data.tecnicoAsignadoId == '')
          && request.resource.data.tecnicoAsignadoId == request.auth.uid
          && request.resource.data.tecnicoAsignadoNombre
            == userDocument(request.auth.uid).data.username
          && request.resource.data.estado == 'en proceso'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado', 'tecnicoAsignadoId', 'tecnicoAsignadoNombre'
          ])
          && hasValidSupportAssignment();
      }

      allow get, list: if signedIn()
        && (isAdmin() || isTechnician() || isRequester() || isAssignedTechnician());
      allow create: if signedIn()
        && request.resource.data.clienteId == request.auth.uid
        && request.resource.data.numero is int
        && request.resource.data.numero
          == getAfter(/databases/$(database)/documents/ticketCounters/global).data.lastNumber
        && getAfter(/databases/$(database)/documents/ticketCounters/global).data.lastTicketId
          == ticketId
        && request.resource.data.estado == 'abierto'
        && request.resource.data.prioridad in ['baja', 'media', 'alta', 'urgente']
        && request.resource.data.categoria in [
          'Soporte Técnico', 'Redes y comunicaciones', 'Desarrollador de sistema'
        ]
        && request.resource.data.keys().hasOnly([
          'titulo', 'categoria', 'descripcion', 'estado', 'prioridad',
          'fechaCreacion', 'clienteId', 'clienteNombre',
          'tecnicoAsignadoId', 'tecnicoAsignadoNombre', 'adjuntos', 'numero'
        ]);
      allow update: if signedIn() && (
        isValidAdminEdit()
        || isValidRequesterOrAssigneeEdit()
        || isValidSelfAssignment()
        || (isRequester()
          && resource.data.estado != 'cerrado'
          && resource.data.adjuntos.size() == 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adjuntos']))
      );
      allow delete: if isAdmin();
    }

    // Restringe la conversación al solicitante, técnico asignado y administradores.
    match /tickets/{ticketId}/messages/{messageId} {
      function parentTicketData() {
        return get(/databases/$(database)/documents/tickets/$(ticketId)).data;
      }

      function isConversationParticipant() {
        return signedIn()
          && (isAdmin()
            || parentTicketData().clienteId == request.auth.uid
            || (isTechnician()
              && parentTicketData().tecnicoAsignadoId == request.auth.uid));
      }

      allow get, list: if isConversationParticipant();
      allow create: if isConversationParticipant()
        && (isAdmin() || parentTicketData().estado != 'cerrado')
        && request.resource.data.keys().hasOnly([
          'text', 'authorId', 'authorName', 'authorRole', 'type', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'text', 'authorId', 'authorName', 'authorRole', 'type', 'createdAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName == userDocument(request.auth.uid).data.username
        && request.resource.data.authorRole == userDocument(request.auth.uid).data.role
        && request.resource.data.type in ['message', 'solution']
        && (request.resource.data.type == 'message'
          || isAdmin()
          || (isTechnician()
            && parentTicketData().tecnicoAsignadoId == request.auth.uid))
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && request.resource.data.createdAt == request.time;
      allow update: if isConversationParticipant()
        && (isAdmin() || parentTicketData().estado != 'cerrado')
        && resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000;
      allow delete: if false;
    }
  }
}
